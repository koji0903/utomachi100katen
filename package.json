{
  "name": "utomachi100katen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:storage-rules": "firebase emulators:exec --only storage --project utomachi100katen-rules-test \"vitest run --config vitest.storage.config.ts\"",
    "test:watch": "vitest",
    "emulator:start": "firebase emulators:start --import=./.emulator-data --export-on-exit",
    "emulator:export": "firebase emulators:export ./.emulator-data",
    "dev:emulator": "concurrently -k -n emulator,next -c yellow,cyan \"npm:emulator:start\" \"cross-env NEXT_PUBLIC_USE_EMULATOR=true FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 next dev\"",
    "seed:emulator": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 SEED_TARGET=emulator tsx scripts/seed-staging.ts",
    "seed:staging": "cross-env SEED_TARGET=staging tsx scripts/seed-staging.ts",
    "deploy:rules:prod": "firebase deploy --only firestore:rules,firestore:indexes,storage --project default",
    "deploy:rules:staging": "firebase deploy --only firestore:rules,firestore:indexes,storage --project staging"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "10.2.9",
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.10.0",
    "@types/dompurify": "^3.0.5",
    "browser-image-compression": "^2.0.2",
    "dompurify": "^3.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "heic2any": "^0.0.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "swr": "^2.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "serialize-javascript": "7.1.4"
  }
}
